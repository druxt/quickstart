{
  "customRules": ["./.markdownlint-rules/no-fence-in-fence.cjs"],
  "config": {
    "local/no-fence-in-fence": true,
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD025": { "front_matter_title": "" },
    "MD033": false,
    "MD034": false,
    "MD041": false,
    "MD036": false,
  },
  "ignores": ["node_modules/**", "**/node_modules/**", "nuxt/**", "drupal/**"],
}
